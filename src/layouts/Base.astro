---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/onest';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { site } from '../content/site';

interface Props {
  title?: string;
  noindex?: boolean;
}
const { title = site.seo.title, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={site.seo.description} />
    <link rel="canonical" href={canonical} />
    {(site.preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Иконки -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F5F2EB" />

    <!-- Превью ссылки в мессенджерах и соцсетях -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.seo.title} />
    <meta property="og:description" content={site.seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.seo.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Класс js ставится до отрисовки, чтобы анимируемые блоки не мигали -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (sessionStorage.getItem('kyr-seen')) {
          document.documentElement.classList.add('no-preloader');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <!-- Vercel Analytics: без cookie и без личных данных, поэтому баннер не нужен -->
    <Analytics />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
