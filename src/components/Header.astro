---
import { site } from '../content/site';
---

<header class="header" data-header>
  <div class="header__inner">
    <a href="#top" class="header__logo" aria-label={`${site.name}, наверх`}>
      <span class="header__mark" aria-hidden="true"></span>
      <span>{site.name}</span>
    </a>

    <nav class="header__nav" aria-label="Основная навигация">
      {site.nav.map((item) => <a href={item.href} class="header__link">{item.label}</a>)}
    </nav>

    <div class="header__actions">
      <a href={site.manager.telegram} target="_blank" rel="noopener" class="btn header__cta" data-magnetic>
        <span class="btn__label">{site.cta}</span>
      </a>
      <button
        class="header__burger"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label>Открыть меню</span>
        <span class="header__burger-line header__burger-line--a"></span>
        <span class="header__burger-line header__burger-line--b"></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <span class="menu__glow" aria-hidden="true"></span>
  <nav class="menu__nav" aria-label="Меню">
    {
      site.nav.map((item) => (
        <a href={item.href} class="menu__link" data-menu-link>
          <span class="menu__label">{item.label}</span>
          <span class="menu__hint">{item.hint}</span>
          <svg class="menu__arrow" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
        </a>
      ))
    }
  </nav>

  <div class="menu__bottom" data-menu-bottom>
    <a href={site.manager.telegram} target="_blank" rel="noopener" class="menu__cta">
      {site.cta}
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.5 3.5 2.8 10.7c-1 .4-1 1.8.1 2.1l4.6 1.4 1.8 5.6c.3.9 1.4 1.1 2 .4l2.6-2.6 4.7 3.4c.8.6 1.9.1 2.1-.8L23.9 5c.2-1.1-1.3-1.9-2.4-1.5ZM9.6 14.1l8.8-6.9-7 7.9-.4 3.1-1.4-4.1Z" /></svg>
    </a>
    <div class="menu__contacts">
      <a href={site.manager.telegram} target="_blank" rel="noopener">
        <span>Telegram</span>{site.manager.telegramHandle}
      </a>
      <a href={site.manager.instagram} target="_blank" rel="noopener">
        <span>Instagram</span>{site.manager.instagramHandle}
      </a>
    </div>
  </div>
</div>

<span class="scroll-progress" aria-hidden="true" data-scroll-progress></span>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding-top: env(safe-area-inset-top, 0px);
    color: var(--ink);
    transition:
      transform 0.6s var(--ease),
      color 0.4s,
      background-color 0.4s;
  }
  .header.is-hidden {
    transform: translateY(-110%);
  }
  .header.is-solid {
    background: rgba(245, 242, 235, 0.8);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  /* Над тёмными секциями шапка становится светлой */
  .header.is-dark {
    color: var(--paper);
  }
  .header.is-dark.is-solid {
    background: rgba(16, 20, 20, 0.72);
  }
  .header.is-menu {
    color: var(--paper);
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transform: none;
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: var(--max);
    margin-inline: auto;
    padding: 14px var(--pad);
  }
  .header__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.02em;
  }
  /* Знак: вертикальный кадр 9:16 */
  .header__mark {
    width: 11px;
    height: 19px;
    border-radius: 3px;
    background: currentColor;
    transition: background-color 0.4s;
  }
  .header.is-dark .header__mark {
    background: var(--lime);
  }
  .header.is-menu .header__mark {
    background: var(--lime);
  }
  .header__nav {
    display: none;
    gap: 32px;
  }
  .header__link {
    position: relative;
    font-weight: 500;
    font-size: 15px;
  }
  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease);
  }
  @media (hover: hover) {
    .header__link:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .header__cta {
    display: none;
    min-height: 44px;
    padding: 0 22px;
    font-size: 15px;
  }
  .header__cta {
    transition:
      color 0.4s var(--ease),
      background-color 0.4s;
  }
  .header.is-dark .header__cta {
    --bg: var(--lime);
    --fg: var(--ink);
    --fill: var(--paper);
    --fill-fg: var(--ink);
  }
  .header__burger {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px currentColor;
    z-index: 2;
  }
  .header__burger-line {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }
  .header__burger-line--a {
    top: 18px;
  }
  .header__burger-line--b {
    top: 24px;
  }
  .header__burger[aria-expanded='true'] .header__burger-line--a {
    transform: translateY(3px) rotate(45deg);
  }
  .header__burger[aria-expanded='true'] .header__burger-line--b {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (min-width: 900px) {
    .header__nav {
      display: flex;
    }
    .header__cta {
      display: inline-flex;
    }
    .header__burger {
      display: none;
    }
  }

  /* ── Мобильное меню: тёмная шторка с подсказками и кнопкой связи ── */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: calc(92px + env(safe-area-inset-top, 0px)) var(--pad)
      calc(24px + env(safe-area-inset-bottom, 0px));
    background: var(--ink);
    color: var(--paper);
    overflow-y: auto;
    clip-path: inset(0 0 100% 0);
  }
  .menu[hidden] {
    display: none;
  }
  .menu__glow {
    position: absolute;
    right: -30%;
    top: -20%;
    width: 90vw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(211, 250, 106, 0.28), transparent);
    pointer-events: none;
  }
  .menu__nav {
    position: relative;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .menu__link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 4px 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .menu__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 8.4vw, 40px);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .menu__hint {
    grid-row: 2;
    font-size: 14px;
    color: var(--smoke);
  }
  .menu__arrow {
    grid-row: 1 / span 2;
    grid-column: 2;
    width: 44px;
    height: 44px;
    padding: 11px;
    border-radius: 50%;
    background: rgba(245, 242, 235, 0.08);
    fill: none;
    stroke: var(--lime);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: background-color 0.3s;
  }
  .menu__link:active .menu__arrow {
    background: var(--lime);
    stroke: var(--ink);
  }
  .menu__bottom {
    position: relative;
    display: grid;
    gap: 12px;
  }
  .menu__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 58px;
    border-radius: 999px;
    background: var(--lime);
    color: var(--ink);
    font-weight: 700;
    font-size: 17px;
  }
  .menu__cta svg {
    fill: currentColor;
  }
  .menu__contacts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .menu__contacts a {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 16px;
    background: rgba(245, 242, 235, 0.06);
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 600;
    font-size: 14px;
    overflow-wrap: anywhere;
  }
  .menu__contacts span {
    font-size: 12px;
    font-weight: 500;
    color: var(--smoke);
  }
</style>
