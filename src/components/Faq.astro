---
import { site } from '../content/site';
const { faq } = site;
import BgText from './BgText.astro';
---

<section class="deco-host faq" id="faq">
  <BgText text="?" top="10%" align="start" solid />

  <div class="wrap faq__grid">
    <h2 class="section-title faq__title">{faq.title}</h2>

    <ul class="faq__list" role="list">
      {
        faq.items.map((item, i) => (
          <li class="faq__item" data-faq>
            <h3 class="faq__h">
              <button
                type="button"
                class="faq__q"
                aria-expanded="false"
                aria-controls={`faq-${i}`}
                id={`faq-q-${i}`}
                data-faq-btn
              >
                <span>{item.q}</span>
                <span class="faq__icon" aria-hidden="true" />
              </button>
            </h3>
            <div
              class="faq__a"
              id={`faq-${i}`}
              role="region"
              aria-labelledby={`faq-q-${i}`}
              data-faq-panel
              hidden
            >
              <p>{item.a}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .faq {
    background: var(--paper);
    padding: clamp(80px, 10vw, 140px) 0 clamp(96px, 12vw, 170px);
  }
  .faq__grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1000px) {
    .faq__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }
  }
  .faq__title {
    max-width: 8ch;
  }
  .faq__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-dark);
  }
  .faq__item {
    border-bottom: 1px solid var(--line-dark);
  }
  .faq__h {
    margin: 0;
    font: inherit;
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 72px;
    padding: 18px 0;
    text-align: left;
    font-weight: 600;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  /* Плюс, который превращается в минус */
  .faq__icon {
    position: relative;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-dark);
    transition:
      background-color 0.35s,
      box-shadow 0.35s;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    background: currentColor;
    transition: transform 0.45s var(--ease);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__q[aria-expanded='true'] .faq__icon {
    background: var(--lime);
    box-shadow: none;
  }
  .faq__q[aria-expanded='true'] .faq__icon::after {
    transform: rotate(0deg);
  }
  @media (hover: hover) {
    .faq__q:hover .faq__icon {
      background: var(--ink);
      color: var(--paper);
      box-shadow: none;
    }
  }
  .faq__a {
    overflow: hidden;
  }
  .faq__a p {
    max-width: 52ch;
    padding: 0 48px 24px 0;
    color: #4d5350;
  }
</style>
