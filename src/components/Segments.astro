---
// «Для кого мы работаем»: три раздела — кафе и рестораны, отели, другой бизнес.
// Фильтр сверху (и кнопки на первом экране) выбирает тип бизнеса: выбранный раздел подсвечивается,
// остальные сворачиваются, а по всему сайту подсвечиваются подходящие услуги и цены.
// Без JS все три раздела просто открыты друг под другом.
import { site, marked, pad } from '../content/site';
import SegIcon from './SegIcon.astro';
const { segments } = site;
import BgText from './BgText.astro';
---

<section class="deco-host segments" id="segments" data-segments>
  <BgText text="для кого" top="3%" align="end" />

  <div class="wrap">
    <div class="segments__head">
      <h2 class="section-title" set:html={marked(segments.title)} />
      <p class="segments__text">{segments.text}</p>
    </div>

    <!-- Фильтр: закрепляется при прокрутке раздела -->
    <div class="segf" data-seg-filter>
      <span class="segf__label">{segments.filterLabel}</span>
      <div class="segf__list" role="group" aria-label={segments.filterLabel}>
        {
          segments.items.map((s) => (
            <button type="button" class="segf__chip" data-seg-pick={s.id} aria-pressed="false">
              <SegIcon name={s.icon} size={18} />
              {s.tab}
            </button>
          ))
        }
        <button type="button" class="segf__chip segf__chip--all" data-seg-pick="" aria-pressed="true">
          {segments.filterAll}
        </button>
      </div>
    </div>

    <div class="segb-list">
      {
        segments.items.map((s, i) => (
          <article class="segb" id={`seg-${s.id}`} data-seg-block={s.id} aria-labelledby={`seg-title-${s.id}`}>
            <header class="segb__head">
              <span class="segb__icon">
                <SegIcon name={s.icon} size={26} />
              </span>
              <div class="segb__heading">
                <span class="segb__n">{pad(i + 1)}</span>
                <h3 class="segb__title" id={`seg-title-${s.id}`}>{s.title}</h3>
              </div>
              <span class="segb__badge">Ваш выбор</span>
              <button type="button" class="segb__open" data-seg-pick={s.id}>
                {segments.more}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </button>
            </header>

            <div class="segb__body">
              <p class="segb__lead">{s.lead}</p>

              <div class="segb__grid">
                <div class="segb__col segb__col--offer">
                  <p class="segb__label">{segments.offerLabel}</p>
                  <ul class="segb__offer" role="list">
                    {s.offer.map((o) => (
                      <li>
                        <span>{o.name}</span>
                        <b>{o.price}</b>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="segb__col">
                  <p class="segb__label">{segments.shootLabel}</p>
                  <ol class="segb__shoot" role="list">
                    {s.shoot.map((item, k) => (
                      <li>
                        <span>{pad(k + 1)}</span>
                        {item}
                      </li>
                    ))}
                  </ol>
                </div>

                <div class="segb__col segb__chat">
                  <p class="segb__label">{segments.askLabel}</p>
                  <div class="segb__bubbles">
                    {s.asks.map((q) => (
                      <p class="segb__bubble">{q}</p>
                    ))}
                    <p class="segb__bubble segb__bubble--answer">
                      <span class="segb__typing" aria-hidden="true">
                        <i />
                        <i />
                        <i />
                      </span>
                      {segments.answer}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="seg__geo">
      <span class="segb__label">{segments.geoLabel}</span>
      <ul class="seg__geo-list" role="list">
        {segments.geo.map((g) => <li>{g}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .segments {
    position: relative;
    background: var(--paper);
    padding: clamp(100px, 12vw, 170px) 0 clamp(80px, 10vw, 140px);
  }
  .segments__head {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 900px) {
    .segments__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.75fr);
      align-items: end;
      gap: 48px;
    }
  }
  .segments__text {
    max-width: 44ch;
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.5;
    color: #4d5350;
  }

  /* ── Фильтр ────────────────────────────── */
  .segf {
    position: sticky;
    top: calc(78px + env(safe-area-inset-top, 0px));
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    width: max-content;
    max-width: 100%;
    margin-top: clamp(32px, 4vw, 52px);
    padding: 8px 8px 8px 18px;
    border-radius: 999px;
    background: rgba(245, 242, 235, 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow:
      inset 0 0 0 1px var(--line-dark),
      0 14px 30px -24px rgba(16, 20, 20, 0.5);
  }
  .segf__label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #5c625e;
  }
  .segf__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .segf__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px 0 14px;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--line-dark);
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .segf__chip--all {
    padding: 0 16px;
    background: transparent;
    box-shadow: none;
    color: #5c625e;
  }
  @media (hover: hover) {
    .segf__chip:hover {
      box-shadow: inset 0 0 0 1.5px var(--ink);
    }
    .segf__chip--all:hover {
      color: var(--ink);
    }
  }
  .segf__chip[aria-pressed='true']:not(.segf__chip--all) {
    background: var(--ink);
    color: var(--lime);
    box-shadow: none;
  }
  .segf__chip--all[aria-pressed='true'] {
    display: none;
  }
  .segf__chip:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  html:not(.js) .segf {
    display: none;
  }
  /* На телефоне фильтр — ровная сетка на всю ширину */
  @media (max-width: 640px) {
    .segf {
      /* На телефоне фильтр не закрепляется — экран и так маленький */
      position: relative;
      top: auto;
      width: 100%;
      padding: 8px;
      border-radius: 22px;
    }
    .segf__label {
      display: none;
    }
    .segf__list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
    }
    .segf__chip {
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      min-height: 62px;
      padding: 8px 6px;
      border-radius: 16px;
      font-size: 12.5px;
      line-height: 1.15;
      white-space: normal;
      text-align: center;
    }
    .segf__chip--all {
      grid-column: 1 / -1;
      min-height: 36px;
      flex-direction: row;
    }
  }

  /* ── Разделы ───────────────────────────── */
  .segb-list {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }
  .segb {
    scroll-margin-top: 110px;
    padding: clamp(22px, 3vw, 44px);
    border-radius: var(--radius-l);
    background: #fff;
    box-shadow: 0 1px 0 rgba(16, 20, 20, 0.04);
    transition:
      box-shadow 0.45s var(--ease),
      opacity 0.45s var(--ease),
      background-color 0.45s var(--ease);
  }
  .segb__head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .segb__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--lime);
  }
  .segb__heading {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .segb__n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    color: #8e948d;
  }
  .segb__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 2.8vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .segb__badge {
    display: none;
    margin-left: auto;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--lime);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }
  .segb__open {
    display: none;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-dark);
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
  }
  .segb__open svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .segb__lead {
    max-width: 36ch;
    margin-top: clamp(18px, 2vw, 26px);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(19px, 1.9vw, 27px);
    line-height: 1.22;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .segb__grid {
    display: grid;
    gap: 14px;
    margin-top: clamp(22px, 2.6vw, 34px);
  }
  @media (min-width: 1000px) {
    .segb__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr) minmax(0, 1fr);
    }
  }
  .segb__col {
    min-width: 0;
    padding: clamp(18px, 2vw, 26px);
    border-radius: 22px;
    background: var(--paper);
  }
  .segb__col--offer {
    background: var(--ink);
    color: var(--paper);
  }
  .segb__label {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #5c625e;
  }
  .segb__col--offer .segb__label {
    color: var(--smoke);
  }
  .segb__offer {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .segb__offer li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .segb__offer li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .segb__offer span {
    font-size: 15px;
    line-height: 1.35;
  }
  .segb__offer b {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.02em;
    color: var(--lime);
  }
  .segb__shoot {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .segb__shoot li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line-dark);
    font-size: 15px;
    line-height: 1.35;
  }
  .segb__shoot li:last-child {
    border-bottom: 0;
  }
  .segb__shoot span {
    flex: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    color: #6f9a1f;
  }

  /* Переписка: вопросы клиентов и наш ответ */
  .segb__bubbles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-top: 14px;
  }
  .segb__bubble {
    max-width: 92%;
    padding: 11px 16px;
    border-radius: 18px 18px 18px 6px;
    background: #fff;
    box-shadow: 0 8px 20px -14px rgba(16, 20, 20, 0.4);
    font-weight: 500;
    font-size: 14.5px;
    line-height: 1.35;
  }
  .segb__bubble--answer {
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
    border-radius: 18px 18px 6px 18px;
    background: linear-gradient(180deg, #e2ff8f, var(--lime) 60%, #c6ec58);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      inset 0 -3px 0 rgba(120, 150, 30, 0.3),
      0 10px 20px -14px rgba(90, 120, 20, 0.6);
    font-weight: 700;
  }
  .segb__typing {
    display: inline-flex;
    gap: 4px;
  }
  .segb__typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink);
    animation: seg-dot 1.2s ease-in-out infinite;
  }
  .segb__typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .segb__typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes seg-dot {
    0%,
    60%,
    100% {
      opacity: 0.35;
      translate: 0 0;
    }
    30% {
      opacity: 1;
      translate: 0 -3px;
    }
  }

  /* ── Состояния фильтра ─────────────────── */
  /* Выбранный раздел: лаймовая рамка и метка «Ваш выбор» */
  :global(html[data-seg]) .segb.is-match {
    box-shadow:
      0 0 0 3px var(--lime),
      0 30px 60px -36px rgba(16, 20, 20, 0.45);
  }
  :global(html[data-seg]) .segb.is-match .segb__badge {
    display: inline-flex;
  }
  /* Остальные свёрнуты до заголовка с кнопкой «Подробнее» */
  :global(html[data-seg]) .segb.is-dim {
    padding-block: clamp(16px, 1.6vw, 22px);
    background: rgba(255, 255, 255, 0.55);
  }
  :global(html[data-seg]) .segb.is-dim .segb__body {
    display: none;
  }
  :global(html[data-seg]) .segb.is-dim .segb__open {
    display: inline-flex;
  }
  :global(html[data-seg]) .segb.is-dim .segb__icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--paper);
  }
  :global(html[data-seg]) .segb.is-dim .segb__title {
    font-size: clamp(19px, 1.8vw, 24px);
  }
  @media (max-width: 520px) {
    .segb__head {
      flex-wrap: wrap;
    }
    .segb__badge,
    .segb__open {
      margin-left: 0;
    }
    :global(html[data-seg]) .segb.is-dim .segb__head {
      flex-wrap: nowrap;
    }
    :global(html[data-seg]) .segb.is-dim .segb__open {
      margin-left: auto;
      padding: 0 12px;
    }
  }

  /* ── География ──────────────────────────── */
  .seg__geo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: clamp(26px, 3vw, 36px);
  }
  .seg__geo-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .seg__geo-list li {
    padding: 9px 16px;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--line-dark);
    font-size: 14px;
    font-weight: 500;
  }
  .seg__geo-list li:last-child {
    background: transparent;
    color: #6b716c;
  }
</style>
