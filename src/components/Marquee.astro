---
import { site } from '../content/site';
// Разделитель — маленький вертикальный кадр, тот же знак, что в логотипе.
const items = [...site.marquee, ...site.marquee];
---

<div class="marquee-wrap">
<div class="marquee" data-marquee aria-label={site.marquee.join(', ')} role="img">
  <div class="marquee__track" data-marquee-track>
    {
      [0, 1].map(() => (
        <div class="marquee__group" aria-hidden="true">
          {items.map((text) => (
            <span class="marquee__item">
              <span>{text}</span>
              <span class="marquee__sep" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
</div>

<style>
  /* Обёртка обрезает повёрнутую ленту, чтобы страница не уезжала вбок */
  .marquee-wrap {
    overflow: hidden;
    /* Сверху цвет первого экрана, снизу — следующего блока */
    background: linear-gradient(var(--paper) 50%, var(--sage) 50%);
    padding-block: calc(2vw + 6px);
    margin-block: calc(-2vw - 6px);
    position: relative;
    z-index: 2;
  }
  .marquee {
    position: relative;
    overflow: hidden;
    padding: clamp(18px, 2.4vw, 30px) 0;
    background: var(--ink);
    color: var(--lime);
    transform: rotate(-1.6deg) scale(1.04);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__group {
    display: flex;
    flex-shrink: 0;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 2.6vw, 40px);
    padding-right: clamp(20px, 2.6vw, 40px);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 3.2vw, 44px);
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .marquee__sep {
    width: 0.36em;
    height: 0.64em;
    border-radius: 0.08em;
    background: var(--paper);
  }
</style>
