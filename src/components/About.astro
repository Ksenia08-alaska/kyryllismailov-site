---
import { site, marked } from '../content/site';
import LiveVideo from './LiveVideo.astro';
const { about } = site;
import BgText from './BgText.astro';
import Floats from './Floats.astro';
---

<section class="deco-host about sage sheet" id="about">
  <span class="deco dots" style="--dx:85%;--dy:25%" aria-hidden="true"></span>
  <BgText text="живые ролики" top="6%" />
  <Floats
    frames={[
      { x: '46%', y: '12%', w: 54, r: -14, kind: 'line', speed: 0.5, hideMobile: true },
      { x: '88%', y: '78%', w: 70, r: 10, kind: 'ink', speed: 0.7 },
      { x: '4%', y: '84%', w: 46, r: 8, kind: 'line', speed: 0.3 },
    ]}
  />

  <div class="wrap about__grid">
    <div class="about__copy">
      <h2 class="section-title" set:html={marked(about.title)} />
      <p class="about__text" set:html={marked(about.text)} />
      <ul class="about__points" role="list">
        {about.points.map((p) => <li>{p}</li>)}
      </ul>

      <p class="about__blogs-label">{about.blogsLabel}</p>
      <ul class="about__blogs" role="list">
        {
          about.blogs.map((b) => {
            const Tag = b.url ? 'a' : 'div';
            return (
              <li>
                <Tag
                  class={`about__blog ${b.url ? 'is-link' : ''}`}
                  {...(b.url ? { href: b.url, target: '_blank', rel: 'noopener' } : {})}
                >
                  <span class="about__blog-name">{b.name}</span>
                  {b.handle && <b>{b.handle}</b>}
                  <span class="about__blog-text">{b.text}</span>
                  {b.url && (
                    <svg class="about__blog-arrow" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  )}
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </div>

    <!-- Видео Кирилла на лаймовой подложке -->
    <div class="about__video" data-about-video>
      <span class="about__halo" aria-hidden="true"></span>
      <div class="about__card">
        <LiveVideo src={about.video.src} mobile={about.video.mobile} poster={about.video.poster} title={about.video.title} />
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding: clamp(110px, 13vw, 180px) 0 clamp(90px, 11vw, 150px);
    overflow: hidden;
  }
  .about__grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .about__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(40px, 5vw, 96px);
    }
  }
  .about__copy {
    min-width: 0;
  }
  .about__text {
    margin-top: 22px;
    max-width: 40ch;
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.5;
    color: #2a302d;
  }
  .about__points {
    display: grid;
    gap: 10px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }
  .about__points li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
  }
  .about__points li::before {
    content: '';
    flex: none;
    width: 10px;
    height: 17px;
    border-radius: 3px;
    background: var(--ink);
  }

  /* ── Два блога Кирилла ─────────────────── */
  .about__blogs-label {
    margin-top: 34px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #4d5350;
  }
  .about__blogs {
    display: grid;
    gap: 10px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 560px) {
    .about__blogs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .about__blog {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    padding: 18px 20px 20px;
    border-radius: 20px;
    background: var(--paper);
    transition:
      background-color 0.3s,
      translate 0.4s var(--ease);
  }
  .about__blog-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.03em;
  }
  .about__blog b {
    font-size: 15px;
  }
  .about__blog-text {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.4;
    color: #4d5350;
  }
  .about__blog-arrow {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.4s var(--ease);
  }
  @media (hover: hover) {
    .about__blog.is-link:hover {
      background: var(--lime);
      translate: 0 -3px;
    }
    .about__blog.is-link:hover .about__blog-arrow {
      translate: 2px -2px;
    }
  }

  /* ── Видео ─────────────────────────────── */
  .about__video {
    position: relative;
    justify-self: center;
    width: min(100%, 340px);
  }
  @media (max-width: 999px) {
    .about__video {
      width: min(76vw, 330px);
    }
  }
  /* Карточка-«экран» для видео, как телефон на первом экране */
  .about__card {
    container-type: inline-size;
    position: relative;
    z-index: 1;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--ink);
    box-shadow: 0 34px 70px -34px rgba(16, 20, 20, 0.6);
    rotate: -2deg;
  }
  .about__halo {
    position: absolute;
    inset: 5% -9% -4% 9%;
    border-radius: var(--radius-l);
    background: var(--lime);
    rotate: 5deg;
  }
</style>
