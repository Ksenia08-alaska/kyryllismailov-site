---
/**
 * Аккуратный вертикальный видеоплеер 9:16 в стиле сайта.
 * Нет файла — показывается заглушка. Есть картинка-обложка — видео не грузится,
 * пока его не запустят (экономим трафик на телефоне).
 */
import { mediaOrNull } from '../lib/media';

interface Props {
  src: string | null;
  poster?: string | null;
  title: string;
  label?: string;
  hint?: string;
  size?: 'l' | 'm';
}
const { src, poster, title, label, hint = 'Нажмите для звука', size = 'm' } = Astro.props;
const file = mediaOrNull(src);
const cover = mediaOrNull(poster);
// Без обложки берём первый кадр самого видео
const videoSrc = file ? (cover ? file : `${file}#t=0.1`) : null;
---

<div class={`player player--${size} ${file ? '' : 'player--empty'}`} data-player>
  {
    videoSrc ? (
      <video
        class="player__video"
        src={videoSrc}
        poster={cover ?? undefined}
        preload={cover ? 'none' : 'metadata'}
        playsinline
                  disablepictureinpicture
        data-player-video
      />
    ) : (
      <span class="player__ph" aria-hidden="true" />
    )
  }

  {label && <span class="player__label">{label}</span>}

  {
    file ? (
      <>
        <button type="button" class="player__toggle" aria-label={`Смотреть: ${title}`} data-player-toggle>
          <span class="player__icon" aria-hidden="true">
            <svg class="i-play" width="18" height="18" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
            <svg class="i-pause" width="18" height="18" viewBox="0 0 24 24"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
          </span>
        </button>
        <button type="button" class="player__mute" aria-label="Выключить звук" data-player-mute>
          <svg class="i-sound" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4Zm-2.5-8.8v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6Z" /></svg>
          <svg class="i-muted" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Zm15.6 3 2.2-2.2-1.4-1.4-2.2 2.2-2.2-2.2-1.4 1.4 2.2 2.2-2.2 2.2 1.4 1.4 2.2-2.2 2.2 2.2 1.4-1.4-2.2-2.2Z" /></svg>
        </button>
        <span class="player__bar" aria-hidden="true"><i data-player-progress /></span>
        <span class="player__hint" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9H4Zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4Zm-2.5-8.8v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6Z" /></svg>
          {hint}
        </span>
      </>
    ) : (
      <span class="player__soon">Видео скоро появится</span>
    )
  }

  <p class="player__title">{title}</p>
</div>

<style>
  .player {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    isolation: isolate;
    box-shadow: 0 30px 60px -34px rgba(16, 20, 20, 0.55);
    transform: translateZ(0);
  }
  .player__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    background: var(--ink);
  }
  .player__ph {
    position: absolute;
    inset: -30%;
    z-index: -2;
    background:
      radial-gradient(35% 28% at 40% 35%, rgba(211, 250, 106, 0.4), transparent 70%),
      linear-gradient(165deg, #33403d, var(--graphite) 55%, #0c1010);
  }
  /* Мягкое затемнение снизу — для подписи */
  .player::after {
    content: '';
    position: absolute;
    inset: 55% 0 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(10, 13, 13, 0.85), transparent);
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .player.is-playing::after {
    opacity: 0;
  }

  /* Вся карточка — одна большая кнопка «смотреть / пауза» */
  .player__toggle {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    cursor: pointer;
  }
  .player__icon {
    display: grid;
    place-items: center;
    width: clamp(56px, 22%, 76px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    transition:
      transform 0.45s var(--ease),
      opacity 0.35s;
  }
  .player__icon svg {
    width: 40%;
    fill: currentColor;
  }
  .player__icon .i-play {
    margin-left: 8%;
  }
  .player__icon .i-pause,
  .player.is-playing .player__icon .i-play {
    display: none;
  }
  .player.is-playing .player__icon .i-pause {
    display: block;
  }
  @media (hover: hover) {
    .player__toggle:hover .player__icon {
      transform: scale(1.1);
    }
  }
  /* Во время просмотра кнопка прячется, при наведении или паузе — появляется */
  .player.is-playing .player__icon {
    opacity: 0;
    transform: scale(0.8);
  }
  @media (hover: hover) {
    .player.is-playing:hover .player__icon {
      opacity: 0.9;
      transform: scale(1);
    }
  }

  .player__mute {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(16, 20, 20, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--paper);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .player.is-started .player__mute {
    opacity: 1;
    pointer-events: auto;
  }
  .player__mute svg {
    width: 20px;
    fill: currentColor;
  }
  .player__mute .i-muted,
  .player.is-muted .player__mute .i-sound {
    display: none;
  }
  .player.is-muted .player__mute .i-muted {
    display: block;
  }

  .player__bar {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 12px;
    height: 3px;
    border-radius: 3px;
    background: rgba(245, 242, 235, 0.25);
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .player.is-started .player__bar {
    opacity: 1;
  }
  .player__bar i {
    position: absolute;
    inset: 0;
    background: var(--lime);
    transform-origin: left;
    transform: scaleX(0);
  }

  .player__label {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--lime);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11px;
    pointer-events: none;
  }
  .player__title {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 22px;
    font-weight: 700;
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.25;
    pointer-events: none;
    transition: opacity 0.35s;
  }
  .player.is-playing .player__title {
    opacity: 0;
  }
  /* Тихий предпросмотр: видео играет без звука, вместо кнопки — подсказка */
  .player__hint {
    position: absolute;
    left: 16px;
    bottom: 18px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 999px;
    background: var(--lime);
    color: var(--ink);
    font-weight: 700;
    font-size: 13px;
    pointer-events: none;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.35s,
      transform 0.5s var(--ease);
  }
  .player__hint svg {
    width: 15px;
    fill: currentColor;
  }
  .player.is-preview .player__hint {
    opacity: 1;
    transform: none;
  }
  .player.is-preview .player__icon,
  .player.is-preview .player__bar,
  .player.is-preview .player__mute {
    opacity: 0 !important;
    pointer-events: none;
  }
  .player.is-preview .player__title {
    opacity: 1;
    bottom: 64px;
  }
  .player.is-preview::after {
    opacity: 1;
  }
  .player__soon {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(245, 242, 235, 0.1);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 12px;
    color: var(--smoke);
    white-space: nowrap;
  }
</style>
